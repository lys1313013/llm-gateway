# 后端本地开发配置（go run ./cmd/gateway 时从当前工作目录加载）
# 复制为 .env 后按需修改：cp .env.example .env

# HTTP 监听端口
PORT=5002

# ===== PostgreSQL =====
# 对应 docker/docker-compose.db.yml，宿主机端口默认映射为 35432
DB_HOST=localhost
DB_PORT=35432
DB_NAME=llm_gateway
DB_USER=postgres
DB_PASSWORD=password
DB_TIMEZONE=Asia/Shanghai

# ===== Auth =====
# JWT signing secret — CHANGE THIS in production!
JWT_SECRET_KEY=dev-secret-key-change-in-production

# token 有效期（小时）
JWT_EXPIRATION_HOURS=168

# ===== Log =====
# debug | info | warn | error
LOG_LEVEL=info

# ===== Session tracking =====
# 按顺序扫描的 session id 请求头（逗号分隔），第一个非空值写入 api_logs.session_id
# SESSION_ID_HEADERS=X-Claude-Code-Session-Id,X-Agent-Session-Id
